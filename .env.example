# Application Environment
ENVIRONMENT=development
APP_NAME=bravo-erp
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL 17
POSTGRES_USER=bravo
POSTGRES_PASSWORD=bravo_dev_secret
POSTGRES_DB=bravo_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bravo:bravo_dev_secret@localhost:5432/bravo_erp

# Redis 7 (Taskiq Broker & Cache)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-Compatible Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_BUCKET_NAME=bravo-erp
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1

# Security & JWT
JWT_SECRET_KEY=bravo-erp-dev-super-secret-jwt-key-change-in-prod-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend Next.js Public Environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
